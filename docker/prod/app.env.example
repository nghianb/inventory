# Mẫu cho /srv/inventory/app.env trên VPS. Chép sang đó, điền giá trị thật, rồi `chmod 600`.
# File này nằm NGOÀI cây source và không bao giờ đi vào image.

APP_NAME="Kho hàng số"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Tên miền thật, có https: reverse proxy cầm TLS nên Laravel phải tự biết điều đó.
APP_URL=https://kho.example.com

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en

# Log ra stderr để đọc bằng `docker compose logs`. File log trong container thì phình vô hạn
# và biến mất mỗi lần deploy. Nhật ký bảo mật của kho nằm trong DB, không nằm ở đây.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Khoá mã hoá của kho, tách khỏi APP_KEY: "<phiên bản>:base64:<32 byte>" (xem ADR 0001).
# Giữ bản sao ngoài server, TÁCH KHỎI BACKUP: mất khoá nội dung là mất toàn bộ hàng.
INVENTORY_CONTENT_KEY=
INVENTORY_CONTENT_PREVIOUS_KEYS=
INVENTORY_HMAC_KEY=
INVENTORY_BACKUP_KEY=

INVENTORY_API_HOLD_MINUTES=15
INVENTORY_API_RATE_LIMIT=60

# DB_* là cho Laravel, POSTGRES_* là cho image postgres. Ba cặp dưới đây PHẢI khớp nhau.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=inventory
DB_USERNAME=inventory
DB_PASSWORD=
POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="kho@example.com"
MAIL_FROM_NAME="${APP_NAME}"
